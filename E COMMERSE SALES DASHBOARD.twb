        <view>
          <datasources>
            <datasource caption='Dataco (Abhijit database)_Dataco' name='federated.1br89ap0emhkew19th12j0ryxt5b' />
          </datasources>
          <datasource-dependencies datasource='federated.1br89ap0emhkew19th12j0ryxt5b'>
            <column caption='YTD Sales LOD' datatype='real' name='[Calculation_1240178810712117248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])={MAX(Year([Order Date]))} THEN [Sales] END)}' />
            </column>
            <column caption='YOY Sales %' datatype='real' name='[Calculation_1240178810714353666]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_1240178810712117248]-[YTD Sales LOD (copy)_1240178810714001409])/[YTD Sales LOD (copy)_1240178810714001409]' />
            </column>
            <column caption='YOY sales margin' datatype='string' name='[Calculation_1240178810716663811]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1240178810714353666]&gt;0 THEN &apos;∆&apos; ELSEIF [Calculation_1240178810714353666]&lt;0 THEN &apos;∇&apos; END' />
            </column>
            <column caption='YTD Sales' datatype='real' name='[Calculation_1240178812080467985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])={max(year([Order Date]))} THEN [Sales] END' />
            </column>
            <column caption='Sales margin' datatype='string' name='[Calculation_1240178812110258196]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Calculation_1240178812080467985])-SUM([YTD Sales (copy)_1240178812109037586])&lt;0 THEN &apos;LESS THAN PY&apos;&#13;&#10;ELSEIF SUM([Calculation_1240178812080467985])-SUM([YTD Sales (copy)_1240178812109037586])&gt;0 THEN &apos;GREATER THAN PY&apos;&#13;&#10;ELSEIF ISNULL(SUM([YTD Sales (copy)_1240178812109037586])) THEN &apos;NO SALES IN PY&apos; &#13;&#10;END' />
            </column>
            <column datatype='string' name='[Customer Segment]' role='dimension' type='nominal' />
            <column datatype='string' name='[Market]' role='dimension' type='nominal' />
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column caption='PYTD Sales' datatype='real' name='[YTD Sales (copy)_1240178812109037586]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date])={max(year([Order Date]))}-1  THEN [Sales] END' />
            </column>
            <column caption='PYTD Sales LOD ' datatype='real' name='[YTD Sales LOD (copy)_1240178810714001409]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])={MAX(Year([Order Date]))-1} THEN [Sales] END)}' />
            </column>
            <column-instance column='[Order Date]' derivation='Max' name='[max:Order Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Order Date]' derivation='Month' name='[mn:Order Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_1240178810716663811]' derivation='None' name='[none:Calculation_1240178810716663811:nk]' pivot='key' type='nominal' />
            <column-instance column='[Customer Segment]' derivation='None' name='[none:Customer Segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Market]' derivation='None' name='[none:Market:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1240178810712117248]' derivation='Sum' name='[sum:Calculation_1240178810712117248:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1240178810714353666]' derivation='Sum' name='[sum:Calculation_1240178810714353666:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
