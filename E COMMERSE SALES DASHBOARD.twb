      <column caption='YOY Quantity  %' datatype='real' name='[YOY Sales % (copy)_1240178810729017355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([YTD Sales LOD (copy)_1240178810727874568]-[PYTD Sales LOD  (copy)_1240178810728153097])/[PYTD Sales LOD  (copy)_1240178810728153097]' />
      </column>
      <column caption='YOY Profit %' datatype='real' name='[YOY Sales (copy)_1240178810722217990]' role='measure' type='quantitative'>
