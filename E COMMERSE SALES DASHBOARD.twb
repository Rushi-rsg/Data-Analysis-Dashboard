      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1240178810712117248]) / TOTAL(SUM([Calculation_1240178810712117248]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YTD Sales LOD' datatype='real' name='[Calculation_1240178810712117248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])={MAX(Year([Order Date]))} THEN [Sales] END)}' />
      </column>
      <column caption='YOY Sales %' datatype='real' name='[Calculation_1240178810714353666]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1240178810712117248]-[YTD Sales LOD (copy)_1240178810714001409])/[YTD Sales LOD (copy)_1240178810714001409]' />
      </column>
      <column caption='YOY sales margin' datatype='string' name='[Calculation_1240178810716663811]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1240178810714353666]&gt;0 THEN &apos;∆&apos; ELSEIF [Calculation_1240178810714353666]&lt;0 THEN &apos;∇&apos; END' />
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_1240178812080467985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])={max(year([Order Date]))} THEN [Sales] END' />
      </column>
      <column caption='% difference' datatype='real' name='[Calculation_1240178812109271059]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1240178812080467985])-SUM([YTD Sales (copy)_1240178812109037586]))/SUM([YTD Sales (copy)_1240178812109037586])' />
      </column>
      <column caption='Sales margin' datatype='string' name='[Calculation_1240178812110258196]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1240178812080467985])-SUM([YTD Sales (copy)_1240178812109037586])&lt;0 THEN &apos;LESS THAN PY&apos;&#13;&#10;ELSEIF SUM([Calculation_1240178812080467985])-SUM([YTD Sales (copy)_1240178812109037586])&gt;0 THEN &apos;GREATER THAN PY&apos;&#13;&#10;ELSEIF ISNULL(SUM([YTD Sales (copy)_1240178812109037586])) THEN &apos;NO SALES IN PY&apos; &#13;&#10;END' />
      </column>
      <column caption='Positive % Difference' datatype='string' name='[Calculation_1240178812112330774]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1240178812109271059]&gt;0 THEN &apos;∆&apos; END' />
      </column>
      <column caption='No Sales' datatype='string' name='[Calculation_1240178812113174552]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1240178812110258196]=&apos;No Sales in PY&apos; THEN &apos;No Sales in PY&apos; END' />
      </column>
      <column datatype='string' name='[Customer City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Customer Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='integer' name='[Customer Id]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Customer State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Customer Zipcode]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
